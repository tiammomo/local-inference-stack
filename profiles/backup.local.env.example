# Copy to profiles/backup.local.env and point it at the checked-out ModelPort repository.
MODELPORT_PROJECT_DIR=/path/to/ModelPort

# Sensitive archives stay outside Git under backups/modelport by default. The
# checked-in hardened systemd unit can write only PROJECT_ROOT/backups; an
# external directory requires a separately reviewed systemd ReadWritePaths=
# override and must be access-controlled plus covered by encrypted off-device backup.
# MODELPORT_BACKUP_DIR=/path/to/reviewed/private/modelport-backups
MODELPORT_BACKUP_RETENTION_DAYS=14

# A backup older than this appears as an operations alert.
OPERATIONS_BACKUP_MAX_AGE_HOURS=36
