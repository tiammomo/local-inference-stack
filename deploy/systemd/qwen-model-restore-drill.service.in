[Unit]
Description=Restore the latest ModelPort backup into an isolated temporary database
After=network-online.target docker.service qwen-model-backup.service
Wants=network-online.target
OnFailure=qwen-model-production-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
EnvironmentFile=@PROJECT_ROOT@/profiles/backup.local.env
ExecStartPre=@PROJECT_ROOT@/scripts/production-alert.sh clear qwen-model-restore-drill.service
ExecStart=@PROJECT_ROOT@/scripts/modelport-backup.sh drill
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@/logs/alerts

[Install]
WantedBy=default.target
