[Unit]
Description=Record and optionally deliver a local inference failure alert for %i

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
@ALERTING_CREDENTIAL_DIRECTIVE@
ExecStart=@PROJECT_ROOT@/scripts/production-alert.sh fire %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@/logs/alerts
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
