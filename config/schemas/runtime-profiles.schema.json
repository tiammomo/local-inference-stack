{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-inference-stack.invalid/schemas/runtime-profiles-v1.json",
  "title": "Local Inference Stack runtime profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "environment"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "environment": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^QWEN_[A-Z0-9_]+$"},
            "additionalProperties": {"type": "string"}
          }
        }
      }
    }
  }
}
